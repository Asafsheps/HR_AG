# ==================================================
# HR PROJECT — Environment Variables
# ==================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
#
# Required vars are marked with [REQUIRED]
# Optional vars are marked with [OPTIONAL]
# ==================================================

# --------------------------------------------------
# SUPABASE [REQUIRED]
# --------------------------------------------------
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------------------------------------------------
# AI PROVIDERS
# --------------------------------------------------
# Default provider: anthropic | openai
AI_DEFAULT_PROVIDER=anthropic                          # [OPTIONAL] default: anthropic

# Anthropic Claude [REQUIRED]
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6              # [OPTIONAL]

# OpenAI (fallback) [OPTIONAL]
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
OPENAI_DEFAULT_MODEL=gpt-4o                            # [OPTIONAL]

# --------------------------------------------------
# WHATSAPP
# --------------------------------------------------
# Provider: twilio | meta
WHATSAPP_PROVIDER=twilio                               # [OPTIONAL] default: twilio

# Twilio [OPTIONAL — required for WhatsApp feature]
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Webhook URL (fill after deploy)
TWILIO_WEBHOOK_URL=https://your-domain.vercel.app/api/webhooks/whatsapp/twilio

# Meta WhatsApp Business API [OPTIONAL]
META_ACCESS_TOKEN=your-meta-permanent-token
META_PHONE_NUMBER_ID=your-phone-number-id
META_WEBHOOK_VERIFY_TOKEN=your-custom-random-string-min-16-chars

# --------------------------------------------------
# APP SETTINGS
# --------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000              # [OPTIONAL] update after deploy
NEXT_PUBLIC_APP_NAME=HR Project                        # [OPTIONAL]

# Feature flags — enable after connecting services
NEXT_PUBLIC_FEATURE_WHATSAPP=false                     # [OPTIONAL]
NEXT_PUBLIC_FEATURE_AI_SCORING=true                    # [OPTIONAL]
NEXT_PUBLIC_FEATURE_ASSIGNMENTS=false                  # [OPTIONAL]

# --------------------------------------------------
# TELEGRAM NOTIFICATIONS [OPTIONAL]
# --------------------------------------------------
# 1. Open @BotFather on Telegram → /newbot → copy token
# 2. Send a message to your bot
# 3. GET https://api.telegram.org/bot<TOKEN>/getUpdates → find chat_id
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=987654321

# --------------------------------------------------
# SECURITY [OPTIONAL]
# --------------------------------------------------
# Random 32+ char string for webhook signature validation
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=change-me-to-a-random-32-char-string
